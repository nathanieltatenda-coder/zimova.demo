# Copy this file to .env and fill it in. Never share it or upload it anywhere public.

# ---- Owner (admin) account: REQUIRED the first time the database is created ----
ADMIN_EMAIL=                    # your real email address
ADMIN_PASSWORD=                 # 10+ characters with letters and numbers (change it later in Profile)
ADMIN_NAME=ZIMOVA Admin
# ADMIN_PHONE=

# ---- Basics ----
PORT=3000
NODE_ENV=production             # production = no on-screen verification codes, HSTS on
TZ=Africa/Harare                # daily payout hour and reports use server time

# ---- Storage: blank = JSON file (fine to start), or PostgreSQL ----
# DATABASE_URL=postgres://user:password@host:5432/zimova
# PGSSL=1                       # many hosted databases require SSL

# ---- Email (verification codes + password reset). Needed for real users ----
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:password@smtp.example.com
# EMAIL_FROM="ZIMOVA <no-reply@example.com>"
# REQUIRE_EMAIL_VERIFICATION=1  # 0 = do not require verified email to book

# ---- SMS (phone verification). Needed for real users; see GOLIVE.md ----
# SMS_PROVIDER=twilio           # twilio | http
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=
# SMS_HTTP_URL=  SMS_HTTP_TOKEN=            # for providers with a simple JSON API
# REQUIRE_PHONE_VERIFICATION=1  # 0 = do not require verified phone to book (not recommended)
# DEFAULT_COUNTRY_CODE=263

# ---- Payments: TEST MODE (simulated, no real money moves) until a real gateway adapter is added. See PAYMENTS.md ----
PAYMENT_PROVIDER=sandbox
# PAYMENT_WEBHOOK_SECRET=       # long random string, set before connecting a real gateway
PAYOUT_HOUR=23

# ---- Push notifications for the phone apps (see mobile/MOBILE.md) ----
# PUSH_PROVIDER=fcm
# FCM_SERVICE_ACCOUNT_JSON=  or  FCM_SERVICE_ACCOUNT_FILE=/path/key.json
# CORS_ORIGINS=capacitor://localhost,https://localhost

# ---- Google Maps (blank = OpenStreetMap) ----
GOOGLE_MAPS_BROWSER_KEY=        # restrict to your website address + Maps JavaScript, Places (New), Geocoding
GOOGLE_MAPS_SERVER_KEY=         # restrict to your server IP + Routes API only. Never put in frontend code.
# GOOGLE_MAPS_MAP_ID=           # create your own Map ID in Google Cloud for production styling

# ---- Hosting behind nginx / Caddy / Render ----
# TRUST_PROXY=1
# FORCE_HTTPS=1
# RATE_LIMIT=600
# OSRM_URL=https://router.project-osrm.org   # routing fallback when no Google server key (light testing only)

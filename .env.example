# Copy this file to .env (never commit .env). Everything is optional for the demo.
PORT=3000
NODE_ENV=development            # set to production when deployed (turns on HSTS, hides sandbox OTP codes)
ADMIN_EMAIL=admin@zimova.test
ADMIN_PASSWORD=change-this-demo-password   # only used the first time the database is created
TZ=Africa/Harare                # payout hour and daily reports use server time

# ---- Storage: leave blank for the JSON file demo, or use PostgreSQL ----
# DATABASE_URL=postgres://user:password@host:5432/zimova
# PGSSL=1                       # many hosted databases require SSL

# ---- Payments (see PAYMENTS.md) ----
PAYMENT_PROVIDER=sandbox        # sandbox = no real money. Real gateways need their adapter in lib/extra.js
# PAYMENT_WEBHOOK_SECRET=       # long random string; the gateway signs webhooks with it
PAYOUT_HOUR=23                  # daily driver payout runs once the server clock reaches this hour

# ---- Phone and email verification, push (see mobile/MOBILE.md). Blank = sandbox: codes appear on screen (never allowed in production)
# SMS_PROVIDER=twilio            # twilio | http   (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM  or  SMS_HTTP_URL, SMS_HTTP_TOKEN)
# EMAIL_PROVIDER=smtp            # SMTP_URL=smtps://user:pass@smtp.example.com   EMAIL_FROM="ZIMOVA <no-reply@example.com>"
# PUSH_PROVIDER=fcm              # FCM_SERVICE_ACCOUNT_JSON=... or FCM_SERVICE_ACCOUNT_FILE=/path/key.json
# REQUIRE_EMAIL_VERIFICATION=1   # set 0 to require only phone verification
# DEFAULT_COUNTRY_CODE=263       # used to turn 0771234567 into +263771234567
# CORS_ORIGINS=capacitor://localhost,https://localhost   # phone-app origins allowed to call the API

# ---- Google Maps (blank = OpenStreetMap demo map) ----
GOOGLE_MAPS_BROWSER_KEY=         # restrict to your website address + Maps JavaScript, Places (New), Geocoding
GOOGLE_MAPS_SERVER_KEY=          # restrict to your server IP + Routes API only. Never put in frontend code.

# ---- Production hardening ----
# TRUST_PROXY=1                  # when behind nginx/Caddy/Render so client IPs and HTTPS are detected correctly
# FORCE_HTTPS=1                  # redirect http to https (needs NODE_ENV=production and a proxy sending x-forwarded-proto)
# RATE_LIMIT=600                 # API requests per IP per minute
# OSRM_URL=https://router.project-osrm.org   # routing fallback when no Google server key (testing only)

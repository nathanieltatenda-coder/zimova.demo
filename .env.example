# Optional configuration. Copy this file to .env (never commit .env).
PORT=3000
ADMIN_EMAIL=admin@zimova.test
ADMIN_PASSWORD=change-this-demo-password

# ---- Google Maps (leave blank to use the OpenStreetMap demo map) ----
# Browser key: restrict to "HTTP referrers" (your domain) and to Maps JavaScript API, Places API (New), Geocoding API.
GOOGLE_MAPS_BROWSER_KEY=
# Server key: restrict to your server IP and to Routes API only. NEVER put this in frontend code.
GOOGLE_MAPS_SERVER_KEY=

# Optional routing endpoint used when no Google server key is set (public OSRM is for light testing only).
# OSRM_URL=https://router.project-osrm.org
